FROM python:3.11-slim AS builder
WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8080


# Install curl for docker HEALTHCHECK
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install inference dependencies only (CPU-only PyTorch to reduce image size)4
COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

# Copy application source code
COPY src/ ./src/

# Security: Create non-root user and set permissions
RUN useradd -m -u 10001 appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

# Health check targeting GET /health
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["python", "src/serve.py"]


